<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProjectGmKernel.Native</AssemblyName>
    <RootNamespace>ProjectGmKernel.Native</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AbiCheck" />
    <InternalsVisibleTo Include="AllocationBaseline" />
    <InternalsVisibleTo Include="PerfBaseline" />
    <InternalsVisibleTo Include="KernelTests" />
    <InternalsVisibleTo Include="ParasolidOracleSmoke" />
    <InternalsVisibleTo Include="ParasolidPrimitiveOracle" />
    <InternalsVisibleTo Include="ParasolidEvaluationOracle" />
    <InternalsVisibleTo Include="ParasolidThreadOracle" />
    <InternalsVisibleTo Include="BCurveEvaluationOracle" />
    <InternalsVisibleTo Include="ParasolidXtCorpusBodyBasics" />
    <InternalsVisibleTo Include="ParasolidXtCorpusCases" />
    <InternalsVisibleTo Include="TopologyDump" />
    <InternalsVisibleTo Include="XtGeometryWriterOracle" />
    <InternalsVisibleTo Include="ProbeXtGeometryNodes" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectGmKernel.Xt\ProjectGmKernel.Xt.csproj" />
  </ItemGroup>
  <Target Name="CheckCoreAllocations" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <AllocationGuardAssembly>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/../../scripts', '$(TargetPath)'))</AllocationGuardAssembly>
    </PropertyGroup>
    <Exec WorkingDirectory="../../scripts" Command="dotnet run GenerateFunctionCatalog.cs -- --check" EnvironmentVariables="MSBUILDDISABLENODEREUSE=1" />
    <Exec WorkingDirectory="../../scripts" Command="dotnet run AllocationBanCheck.cs -- &quot;$(AllocationGuardAssembly)&quot;" EnvironmentVariables="MSBUILDDISABLENODEREUSE=1" />
  </Target>
</Project>
