<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(KernelTestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);KERNEL_TEST_HOOKS</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\testhooks\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\testhooks\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProjectGmKernel.Native</AssemblyName>
    <RootNamespace>ProjectGmKernel.Native</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AbiCheck" />
    <InternalsVisibleTo Include="AllocationBaseline" />
    <InternalsVisibleTo Include="PerfBaseline" />
    <InternalsVisibleTo Include="KernelTests" />
    <InternalsVisibleTo Include="ParasolidOracleSmoke" />
    <InternalsVisibleTo Include="ParasolidPrimitiveOracle" />
    <InternalsVisibleTo Include="ParasolidEvaluationOracle" />
    <InternalsVisibleTo Include="ParasolidThreadOracle" />
    <InternalsVisibleTo Include="BCurveEvaluationOracle" />
    <InternalsVisibleTo Include="IcurveEvalBenchmark" />
    <InternalsVisibleTo Include="IcurveEvaluationOracle" />
    <InternalsVisibleTo Include="ParametricICurveOracle" />
    <InternalsVisibleTo Include="ParasolidXtCorpusBodyBasics" />
    <InternalsVisibleTo Include="ParasolidXtCorpusCases" />
    <InternalsVisibleTo Include="TopologyDump" />
    <InternalsVisibleTo Include="XtGeometryWriterOracle" />
    <InternalsVisibleTo Include="ProbeXtGeometryNodes" />
    <InternalsVisibleTo Include="ConeAxisProbe" />
    <InternalsVisibleTo Include="GeometryPublicApiOracle" />
    <InternalsVisibleTo Include="ProfileModelingOracle" />
    <InternalsVisibleTo Include="BrepImportOracle" />
    <InternalsVisibleTo Include="GeometryTransformOracle" />
    <InternalsVisibleTo Include="ProjectGmKernel.DisplayBridge" />
    <InternalsVisibleTo Include="DisplayBridgeOracle" />
    <InternalsVisibleTo Include="BooleanOperationOracle" />
    <InternalsVisibleTo Include="AnalyticBooleanOracle" />
    <InternalsVisibleTo Include="AnalyticSectionOracle" />
    <InternalsVisibleTo Include="PlanarTrackingOracle" />
    <InternalsVisibleTo Include="IntersectionOperationOracle" />
    <InternalsVisibleTo Include="FreeformModelingOracle" />
    <InternalsVisibleTo Include="CurvedSheetPartitionOracle" />
    <InternalsVisibleTo Include="LocalOperationOracle" />
    <InternalsVisibleTo Include="RotationalModelingOracle" />
    <InternalsVisibleTo Include="BCurveAnalyticIntersectionOracle" />
    <InternalsVisibleTo Include="LocalTopologyChangeOracle" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectGmKernel.Xt\ProjectGmKernel.Xt.csproj" />
  </ItemGroup>
  <!-- Opt-in for build hosts that cannot establish the SDK's task-host IPC.
       Execute the same trusted SDK tasks in the current .NET MSBuild process. -->
  <UsingTask TaskName="ComputeManagedAssemblies" AssemblyFile="$(ILLinkTasksAssembly)" Override="true"
             Condition="'$(GmInProcessLinkTasks)' == 'true' and '$(MSBuildRuntimeType)' == 'Core' and '$(ILLinkTasksAssembly)' != ''" />
  <UsingTask TaskName="ILLink" AssemblyFile="$(ILLinkTasksAssembly)" Override="true"
             Condition="'$(GmInProcessLinkTasks)' == 'true' and '$(MSBuildRuntimeType)' == 'Core' and '$(ILLinkTasksAssembly)' != ''" />
  <Target Name="CheckCoreAllocations" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <AllocationGuardAssembly>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/../../scripts', '$(TargetPath)'))</AllocationGuardAssembly>
    </PropertyGroup>
    <Exec WorkingDirectory="../../scripts" Command="dotnet run GenerateFunctionCatalog.cs -p:UseSharedCompilation=false -p:BuildInParallel=false -- --check" EnvironmentVariables="MSBUILDDISABLENODEREUSE=1" />
    <Exec WorkingDirectory="../../scripts" Command="dotnet run AllocationBanCheck.cs -p:UseSharedCompilation=false -p:BuildInParallel=false -- &quot;$(AllocationGuardAssembly)&quot;" EnvironmentVariables="MSBUILDDISABLENODEREUSE=1" />
  </Target>
</Project>
