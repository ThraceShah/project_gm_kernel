<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProjectGmKernel.Xt</AssemblyName>
    <RootNamespace>ProjectGmKernel.Xt</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>true</IsPackable>
    <PackageId>ProjectGmKernel.Xt</PackageId>
    <Version>0.1.0</Version>
    <Authors>ThraceShah</Authors>
    <Description>Parasolid XT text codec with exact V30-V38 schema-node models.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>..\..\bin\nuget</PackageOutputPath>
    <!-- Optional: set XtEmbeddedSchemaDir=<schema directory> (e.g.
         -p:XtEmbeddedSchemaDir=../third_party/parasolid/schema) to embed every
         sch_*.sch_txt / sch_*.s_t file as XtSchema.* resources so
         XtSchemaCatalog.OpenBuiltIn() resolves them without a schema directory.
         Off by default: published artifacts must not contain raw .sch_txt text
         (scripts/ScanXtArtifacts.cs fails the pack while this is enabled).
         Embedded-schema archives are always covered by the generated V13 base
         binding SCH_1300120_13006 instead. -->
  </PropertyGroup>
  <ItemGroup Condition="'$(XtEmbeddedSchemaDir)' != ''">
    <EmbeddedResource Include="$(XtEmbeddedSchemaDir)\sch_*.sch_txt;$(XtEmbeddedSchemaDir)\sch_*.s_t" LogicalName="XtSchema.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Target Name="ScanXtPackage" AfterTargets="Pack">
    <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../../scripts/ScanXtArtifacts.cs&quot; -- &quot;$(PackageOutputPath)/$(PackageId).$(PackageVersion).nupkg&quot;" />
  </Target>
</Project>
