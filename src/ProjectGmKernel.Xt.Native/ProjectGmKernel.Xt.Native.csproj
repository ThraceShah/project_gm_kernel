<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProjectGmKernel.Xt.Native</AssemblyName>
    <RootNamespace>ProjectGmKernel.Xt.Native</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectGmKernel.Xt\ProjectGmKernel.Xt.csproj" />
    <None Include="include\ProjectGmKernel.Xt.h" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="include\ProjectGmKernel.Xt.Schema.generated.h" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ScanXtNativeArtifacts" AfterTargets="Publish">
    <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../../scripts/ScanXtArtifacts.cs&quot; -- &quot;$(PublishDir)&quot;" />
  </Target>
</Project>
