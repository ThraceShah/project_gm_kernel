<Project>
  <ItemGroup Condition="'$(UsePskernelSharpUsings)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../../third_party/PKToy/PskernelSharp/Using.cs" Link="PskernelSharp.Using.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseParasolidScriptHost)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../ParasolidScriptHost.cs" Link="ParasolidScriptHost.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../ParasolidBodyCompare.cs" Link="ParasolidBodyCompare.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseParasolidXtCorpusHost)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../ParasolidXtCorpusHost.cs" Link="ParasolidXtCorpusHost.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../ParasolidXtSchemaInspector.cs" Link="ParasolidXtSchemaInspector.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../CorpusManagedKernel.cs" Link="CorpusManagedKernel.cs" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/ProjectGmKernel.Native/ProjectGmKernel.Native.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UseParasolidXtCorpusHost)' == 'true'">
    <AssemblyName>ParasolidXtCorpusCases</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseCorpusManagedKernel)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../CorpusManagedKernelBodyWriter.cs" Link="CorpusManagedKernelBodyWriter.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseWebProgressCapture)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../WebProgressCapture.cs" Link="WebProgressCapture.cs" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/ProjectGmKernel.DisplayBridge/ProjectGmKernel.DisplayBridge.csproj" />
  </ItemGroup>
</Project>
