      "owner": "solid-cylinder",
      "parameters": { "radius": 2.0, "height": 5.0, "endpointVertexCount": 0 },
      "coverage": ["topology", "topology.edge.valence.0", "topology.edge.ring", "topology.loop.fin-count.one"],
      "expectedEntityCounts": { "regions": 2, "shells": 2, "faces": 3, "loops": 4, "fins": 4, "edges": 2, "vertices": 0 },
      "output": "topology.edge.valence.zero.cylinder/model.x_t",
      "verification": "typed-edge-ask-self-receive"
    },
    {
      "caseId": "topology.face.inner-loop.block-cylinder-hole",
      "status": "success",
      "producer": "PK_BODY_boolean_2(PK_boolean_subtract)",
      "entity": "FACE/LOOP",
      "owner": "solid-block-with-through-hole",
      "parameters": { "target": "block(10,10,10)", "tool": "coaxial-cylinder(radius=2,height=10)", "operation": "subtract" },
      "coverage": ["topology.face.inner-loop", "topology.loop.inner", "topology.loop.winding", "topology.region.multiple", "topology.shell.multiple"],
      "expectedEntityCounts": { "regions": 2, "shells": 2, "faces": 7, "loops": 10, "fins": 28, "edges": 14, "vertices": 8 },
      "output": "topology.face.inner-loop.block-cylinder-hole/model.x_t",
      "verification": "typed-loop-ask-self-receive"
    },
    {
      "caseId": "topology.loop.wire.imprint-line",
      "status": "success",
      "producer": "PK_FACE_imprint_curve(PK_BCURVE)",
      "entity": "LOOP",
      "owner": "sheet-body.face",
      "parameters": { "surface": "sheet-rectangle(5,5)", "curve": "degree-1-polyline", "interval": [0, 1], "endpointVertices": 2 },
      "coverage": ["topology.loop.wire", "topology.loop.fin-count.two"],
      "expectedEntityCounts": { "regions": 1, "shells": 1, "faces": 1, "loops": 2, "fins": 6, "edges": 5, "vertices": 6 },
      "output": "topology.loop.wire.imprint-line/model.x_t",
      "verification": "typed-loop-ask-self-receive"
    },
    {
