      "caseId": "topology.loop.ring-classification",
      "status": "success",
      "producer": "PK_BODY_create_sheet_rectangle + PK_FACE_euler_make_ring_loop + PK_LOOP_ask_type",
      "entity": "LOOP",
      "owner": "sheet-body.face",
      "parameters": { "source": "PK_BODY_create_sheet_rectangle(2,3)", "operation": "PK_FACE_euler_make_ring_loop", "observedTypes": ["error", "outer"] },
      "coverage": ["topology", "topology.loop", "loop/ring", "diagnostic-probe"],
      "expectedEntityCounts": { "regions": 1, "shells": 1, "faces": 1, "loops": 3, "fins": 6, "edges": 5, "vertices": 4 },
