{
  "schemaVersion": 1,
  "group": "manifold-topology",
  "scope": "Typed manifold topology classifications and edge endpoint valences retained in independent x_t fixtures.",
  "cases": [
    {
      "caseId": "topology.loop.outer.rectangle",
      "status": "success",
      "producer": "PK_BODY_create_sheet_rectangle + PK_LOOP_ask_type",
      "entity": "LOOP",
      "owner": "sheet-body.face",
      "parameters": { "source": "PK_BODY_create_sheet_rectangle(2,3)", "loopType": "outer" },
      "coverage": ["topology", "topology.loop.outer", "topology.loop.fin-count.multi", "topology.vertex.endpoint"],
      "expectedEntityCounts": { "regions": 1, "shells": 1, "faces": 1, "loops": 1, "fins": 4, "edges": 4, "vertices": 4 },
      "output": "topology.loop.outer.rectangle/model.x_t",
      "verification": "typed-loop-ask-self-receive"
    },
    {
      "caseId": "topology.loop.vertex.cone-apex",
      "status": "success",
      "producer": "PK_BODY_create_solid_cone + PK_LOOP_ask_type",
      "entity": "LOOP",
      "owner": "solid-cone.face",
      "parameters": { "radius": 0.0, "height": 5.0, "semiAngle": 0.25, "loopType": "vertex" },
      "coverage": ["topology", "topology.loop.vertex", "topology.edge.valence.0", "topology.vertex.apex"],
      "expectedEntityCounts": { "regions": 2, "shells": 2, "faces": 2, "loops": 3, "fins": 2, "edges": 1, "vertices": 1 },
      "output": "topology.loop.vertex.cone-apex/model.x_t",
      "verification": "typed-loop-ask-self-receive"
    },
    {
      "caseId": "topology.edge.valence.zero.cylinder",
