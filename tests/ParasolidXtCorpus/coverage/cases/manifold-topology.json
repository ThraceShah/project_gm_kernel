      "entity": "FACE/LOOP",
      "owner": "solid-block-with-two-through-holes",
      "parameters": { "target": "block(12,10,10)", "tools": "two cylinders(radius=1.5,height=10)", "operation": "subtract" },
      "coverage": ["topology.face.inner-loop", "topology.loop.inner", "topology.manifold.multiple-holes"],
      "output": "topology.face.multiple-holes/model.x_t",
